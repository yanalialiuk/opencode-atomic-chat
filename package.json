{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-atomic-chat",
  "version": "0.1.0",
  "description": "OpenCode plugin for Atomic Chat: auto-detection and dynamic model discovery (OpenAI-compatible local API)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "build": "npm run typecheck && npm run test:run"
  },
  "keywords": [
    "opencode",
    "atomic-chat",
    "atomicchat",
    "plugin",
    "local-llm",
    "openai-compatible"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_USERNAME/opencode-atomic-chat.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USERNAME/opencode-atomic-chat/issues"
  },
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/opencode-atomic-chat#readme",
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.166"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
